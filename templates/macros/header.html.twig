{# Pieces shared by the header's icon menus and the phone menu panel. Macros
   don't see the template's variables, so the caller passes what they need. #}

{% macro theme_icon(mode) %}
    {%- if mode == 'light' -%}
    <svg class="header-menu-icon theme-icon theme-icon-light" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle cx="8" cy="8" r="3" fill="currentColor"/>
        <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none">
            <path d="M8 1v2M8 13v2M1 8h2M13 8h2"/>
            <path d="M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4"/>
        </g>
    </svg>
    {%- elseif mode == 'dark' -%}
    <svg class="header-menu-icon theme-icon theme-icon-dark" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M13.5 9.7A6 6 0 0 1 6.3 2.5a6.2 6.2 0 1 0 7.2 7.2z" fill="currentColor"/>
    </svg>
    {%- else -%}
    <svg class="header-menu-icon theme-icon theme-icon-auto" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor"/>
    </svg>
    {%- endif -%}
{% endmacro %}

{# rawRoute, not route or url: route returns '/' on the blog listing (it is
   the home alias) and drops the /blog segment when the switch happens.
   rawRoute is the route without language prefix and survives the switch. #}
{% macro lang_links(language, page, base_url_simple, class) %}
    {%- for code in language.getLanguages() -%}
        {%- if code == language.getLanguage() -%}
        <span class="{{ class }}" aria-current="true">{{ code|upper }}</span>
        {%- else -%}
        <a class="{{ class }}" hreflang="{{ code }}" lang="{{ code }}"
           href="{{ base_url_simple }}{{ code == language.getDefault ? '' : '/' ~ code }}{{ page.rawRoute ?: '/' }}">{{ code|upper }}</a>
        {%- endif -%}
    {%- endfor -%}
{% endmacro %}

{% macro theme_buttons(theme_mode, class) %}
    {%- import _self as header -%}
    {%- for mode, label in { light: 'THEME_BCN.THEME_TOGGLE.LIGHT', dark: 'THEME_BCN.THEME_TOGGLE.DARK', auto: 'THEME_BCN.THEME_TOGGLE.AUTO' } %}
    <button type="button" class="{{ class }}" data-theme-mode-set="{{ mode }}"
            aria-pressed="{{ theme_mode == mode ? 'true' : 'false' }}">
        {{ header.theme_icon(mode) }}<span>{{ label|t }}</span>
    </button>
    {%- endfor %}
{% endmacro %}
