{# Two icon menus on the right of the header: language and theme. Each is a
   disclosure (button + hidden panel) driven by header-settings.js. Panels are
   divs, not lists: Pico pulls `nav ul`/`nav li` around with negative margins. #}
{% import 'macros/header.html.twig' as header %}
{% set theme_mode = html_mode|default(theme_var('theme_mode', 'auto')) %}
<div class="header-menus">
    <div class="header-menu">
        <button type="button" class="header-menu-toggle" data-bcn-disclosure
                aria-expanded="false" aria-controls="bcn-lang-menu"
                aria-label="{{ 'THEME_BCN.LANG_SWITCH.LABEL'|t|e('html_attr') }}"
                title="{{ 'THEME_BCN.LANG_SWITCH.LABEL'|t|e('html_attr') }}">
            <svg class="header-menu-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <g fill="none" stroke="currentColor" stroke-width="1.4">
                    <circle cx="8" cy="8" r="6.3"/>
                    <path d="M1.7 8h12.6M8 1.7c1.9 1.8 2.8 3.9 2.8 6.3S9.9 12.5 8 14.3M8 1.7C6.1 3.5 5.2 5.6 5.2 8s.9 4.5 2.8 6.3"/>
                </g>
            </svg>
        </button>
        <div class="header-menu-panel" id="bcn-lang-menu" hidden>
            {{ header.lang_links(grav.language, page, base_url_simple, 'header-menu-item') }}
        </div>
    </div>
    <div class="header-menu">
        <button type="button" class="header-menu-toggle" data-bcn-disclosure
                aria-expanded="false" aria-controls="bcn-theme-menu"
                aria-label="{{ 'THEME_BCN.THEME_TOGGLE.LABEL'|t|e('html_attr') }}"
                title="{{ 'THEME_BCN.THEME_TOGGLE.LABEL'|t|e('html_attr') }}">
            {# All three icons ship; CSS shows the one for html[data-theme-mode]. #}
            {{ header.theme_icon('light') }}{{ header.theme_icon('dark') }}{{ header.theme_icon('auto') }}
        </button>
        <div class="header-menu-panel" id="bcn-theme-menu" hidden>
            {{ header.theme_buttons(theme_mode, 'header-menu-item') }}
        </div>
    </div>
</div>
