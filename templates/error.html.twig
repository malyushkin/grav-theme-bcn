{% extends 'base.html.twig' %}

{% block content %}
<article class="post">
    <header class="post-header">
        <h1 class="post-title">{{ page.title }}</h1>
    </header>
    <div class="post-content">
        {{ page.content|raw }}
        <p><a href="{{ home_url }}">&larr; Back home</a></p>
    </div>
</article>
{% endblock %}
